{
  "name": "oyster-linter",
  "displayName": "Oyster Linter",
  "description": "Lints Oyster 4S scripts for syntax and command errors.",
  "icon": "img/oysterIcon.png",
  "publisher": "AnActualPan",
  "version": "2.2.3",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "oyster",
        "aliases": [
          "Oyster 4.1.0",
          "Oyster"
        ],
        "icon": {
          "light": "img/oysterIcon.png",
          "dark": "img/oysterIcon.png"
        },
        "extensions": [
          ".osf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oyster",
        "scopeName": "source.oyster",
        "path": "./syntaxes/oyster.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "clean-webpack-plugin": "^4.0.0",
    "path": "^0.12.7",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack-cli": "^7.2.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Danicus2000000/oyster-linter.git"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.6": true,
    "keytar@7.9.0": true
  }
}